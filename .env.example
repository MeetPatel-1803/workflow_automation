# ---- Application ----
NODE_ENV=development
PORT=3000
# Number of reverse-proxy hops to trust for client IP (rate limiting). Leave unset when not behind a proxy.
# TRUST_PROXY=1

# ---- PostgreSQL (used by docker-compose and by the local DATABASE_URL below) ----
POSTGRES_USER=workflow
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=workflow
# For local (non-docker) dev the DB is published on localhost:5432. Inside compose this is overridden to host "postgres".
DATABASE_URL=postgresql://workflow:change-me-postgres@localhost:5432/workflow?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional logical DB index (default 0)
# REDIS_DB=0

# ---- JWT ----
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1h

# ---- Worker (src/worker.ts, the `worker` service in docker-compose.yml) ----
# How many workflow-execution jobs one worker process handles concurrently.
# Only read by the worker process; unused by the API. Default 5 if unset.
WORKER_CONCURRENCY=5
